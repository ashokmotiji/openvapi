# OpenVapi + Dograh Environment
# Copy to .env and fill your keys

# Dograh / App
ENVIRONMENT=local
LOG_LEVEL=INFO
OSS_JWT_SECRET=ChangeMeInProduction
ENABLE_TELEMETRY=true

# Database / Cache / Storage (handled by Docker)
# No need to change for local

# Telnyx (for phone calls - get at https://telnyx.com)
# Add your key here or configure in Dograh UI after first run
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_PHONE_NUMBER=+your_number_here

# LiveKit (optional for extra browser real-time - get free at https://cloud.livekit.io)
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret
LIVEKIT_SERVER_URL=wss://your-project.livekit.cloud

# Ollama (local LLM - runs automatically via Docker)
OLLAMA_HOST=http://ollama:11434   # Or your local Ollama URL

# Optional cloud fallbacks for better quality (uncomment if wanted)
# OPENAI_API_KEY=sk-...
# DEEPGRAM_API_KEY=...
# CARTESIA_API_KEY=...
# ELEVENLABS_API_KEY=...